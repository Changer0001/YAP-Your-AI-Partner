# IT Copilot configuration. Copy to `.env` and adjust as needed.
# `.env` is gitignored — never commit secrets.

# --- Local AI (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# --- Storage (kept local) ---
DATA_DIR=./data

# --- Retrieval / RAG parameters ---
CHUNK_SIZE=250
CHUNK_OVERLAP=50
TOP_K=5
SIMILARITY_THRESHOLD=0.2
MAX_CONTEXT_CHARS=6000

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- Assistant identity (used for greetings/identity answers, NOT from documents) ---
ASSISTANT_NAME=IT Copilot
ASSISTANT_OWNER=your IT team
ORG_NAME=

# --- Server (localhost only by default) ---
HOST=127.0.0.1
PORT=8000

# --- Authentication ---
# On first run the app prompts you to create an admin account in the browser.
# The signing secret is auto-generated in data/secret.key (never commit it).
SESSION_TTL_HOURS=12

# IT Copilot configuration. Copy to `.env` and adjust as needed.
# `.env` is gitignored — never commit secrets.

# --- Local AI (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# --- Storage (kept local) ---
DATA_DIR=./data

# --- Retrieval / RAG parameters ---
CHUNK_SIZE=250
CHUNK_OVERLAP=50
TOP_K=5
SIMILARITY_THRESHOLD=0.2
MAX_CONTEXT_CHARS=6000

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- Server (localhost only by default) ---
HOST=127.0.0.1
PORT=8000
